generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("member") // Can be "member", "admin", etc.
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Apartment {
  id          String   @id @default(uuid())
  title       String
  description String?
  price       Float
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgreementRequest {
  id          String   @id @default(uuid())
  userEmail   String
  apartmentId String?
  status      String   @default("pending") // e.g., "pending", "approved", "rejected"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AcceptedRequest {
  id          String   @id @default(uuid())
  userEmail   String
  apartmentId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id        String   @id @default(uuid())
  code      String   @unique
  discount  Float
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id          String   @id @default(uuid())
  email       String
  amount      Float
  confim_id   String?
  status      String   @default("completed")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
