generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("member") // Can be "member", "admin", etc.
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Apartment {
  id            String   @id @default(uuid())
  apartmentNo   String
  blockName     String
  floorNo       Int
  rent          Float
  imageUrl      String?
  status        String   @default("available")
  bookedBy      String?
  paymentStatus String?  @default("unpaid")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AgreementRequest {
  id                 String   @id @default(uuid())
  userName           String?
  userEmail          String
  floorNo            Int?
  apartmentNo        String?
  blockName          String?
  rent               Float?
  apartment_id       String?
  Agreement_req_date DateTime @default(now())
  status             String   @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AcceptedRequest {
  id          String   @id @default(uuid())
  userEmail   String
  apartmentId String?
  apartmentNo String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaintenanceRequest {
  id          String   @id @default(uuid())
  userEmail   String
  title       String
  description String
  status      String   @default("pending") // pending, in-progress, resolved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id          String   @id @default(uuid())
  email       String
  amount      Float
  confim_id   String?
  status      String   @default("completed")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
